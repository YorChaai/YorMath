							"pm.test(\"Perbandingan ekuivalen konsisten\", function () {",
							"    const r = data.ratio;",
							"    pm.expect(r.a / r.b).to.eql(r.targetA / r.answer);",
							"    pm.expect(r.answer).to.eql(r.b * r.multiplier);",
							"});"
						],
						"type": "text/javascript"
					}

							"",
							"pm.test(\"Penjumlahan dan Perkalian terhitung akurat\", function () {",
							"    pm.expect(data.addition.a + data.addition.b).to.eql(data.addition.expectedAnswer);",
							"    pm.expect(data.multiplication.a * data.multiplication.b).to.eql(data.multiplication.expectedAnswer);",
							"});",
							"",
							"pm.test(\"Pengurangan tanpa negatif selalu menghasilkan answer >= 0\", function () {",
							"    const sub = data.subtractionNonNegative;",
							"    pm.expect(sub.a).to.be.at.least(sub.b);",
							"    pm.expect(sub.expectedAnswer).to.be.at.least(0);",
							"});",
							"",
							"pm.test(\"Pembagian selalu bersih tanpa sisa\", function () {",
							"    const div = data.divisionClean;",
							"    pm.expect(div.a % div.b).to.eql(0);",

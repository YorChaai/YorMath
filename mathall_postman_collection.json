					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
							"const res = pm.response.json();",
							"const data = res.json || (typeof res.data === 'string' ? JSON.parse(res.data) : res.data) || {};",
							"",
							"pm.test(\"Akar kuadrat selalu integer murni (tidak ada simbol akar di answer)\", function () {",
							"    data.roots.forEach(r => {",
							"        pm.expect(r.answer).to.match(/^[0-9]+$/);",
							"        pm.expect(r.answer).to.not.include('√');",
							"    });",
							"});",
							"",
							"pm.test(\"Perhitungan Pangkat akurat dan tidak overflow\", function () {",

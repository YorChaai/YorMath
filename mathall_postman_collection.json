			"name": "3. Logic - Basic Operations (Add, Sub, Mul, Div)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",

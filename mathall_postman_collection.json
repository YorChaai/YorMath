							"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
							"const res = pm.response.json();",
							"const data = res.json || (typeof res.data === 'string' ? JSON.parse(res.data) : res.data) || {};",
							"",
							"pm.test(\"1-Var Presets memiliki xDigit valid 1..10\", function () {",
							"    pm.expect(data.var1Presets).to.be.an('array');",
							"    data.var1Presets.forEach(p => {",
